<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/triv"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TriviaActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/triviaList"
        android:layout_width="422dp"
        android:layout_height="0dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="16dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="183dp"
        android:layout_height="40dp"
        android:text="GoBack"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="675dp" />

    <Button
        android:id="@+id/randomButton"
        android:layout_width="338dp"
        android:layout_height="43dp"
        android:text="RandomPlay"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="525dp" />

    <TextView
        android:id="@+id/nameView"
        android:layout_width="143dp"
        android:layout_height="22dp"
        android:text="Enter your name "
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="386dp" />

    <EditText
        android:id="@+id/answerText"
        android:layout_width="159dp"
        android:layout_height="37dp"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="46dp"
        tools:layout_editor_absoluteY="281dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="119dp"
        android:layout_height="35dp"
        android:text="choose from 1-50 question"
        tools:layout_editor_absoluteX="476dp"
        tools:layout_editor_absoluteY="179dp" />

    <EditText
        android:id="@+id/questionText"
        android:layout_width="125dp"
        android:layout_height="28dp"
        android:ems="10"
        android:inputType="number"
        tools:layout_editor_absoluteX="476dp"
        tools:layout_editor_absoluteY="235dp" />

    <Button
        android:id="@+id/testButton"
        android:layout_width="162dp"
        android:layout_height="46dp"
        android:text="top Scores "
        tools:layout_editor_absoluteX="27dp"
        tools:layout_editor_absoluteY="604dp" />

    <EditText
        android:id="@+id/categoryText"
        android:layout_width="184dp"
        android:layout_height="44dp"
        android:ems="10"
        android:inputType="text"
        android:text="Choose category"
        tools:layout_editor_absoluteX="476dp"
        tools:layout_editor_absoluteY="288dp" />

</androidx.constraintlayout.widget.ConstraintLayout>